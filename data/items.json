      "name": "Effect: Sectioned (Unfolded)",
      "type": "effect",
      "img": "icons/commodities/treasure/token-runed-mem-red.webp",
      "system": {
        "description": {
          "gm": "",
          "value": "<p>Granted by the <em>sectioned</em> rune. The weapon has separated into linked segments joined by fine chain.</p><hr /><p>The weapon gains the <strong>reach</strong> trait. You take a &minus;2 circumstance penalty to Strikes against adjacent creatures (applied automatically when a target is within 5 feet). When you critically hit with the unfolded weapon, the target takes 1d4 persistent bleed damage.</p><p>Refolding the weapon is an Interact action &mdash; delete this effect, or use the <em>Sectioned: Unfold / Refold</em> macro.</p>"
        },
